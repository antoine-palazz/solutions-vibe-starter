# Build context is the repository root.
FROM node:22-slim

WORKDIR /app
RUN corepack enable

# NEXT_PUBLIC_* vars are inlined at build time.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY apps/frontend/package.json ./
RUN pnpm install

COPY apps/frontend/ ./
RUN pnpm build

EXPOSE 3000
CMD ["pnpm", "start"]
