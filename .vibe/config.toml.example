# Exemple de configuration Vibe.
#
# Vibe lit la config globale depuis ~/.vibe/config.toml. Ce fichier est un exemple
# assaini des parties pertinentes pour ce repo (les serveurs MCP utilisés par les
# agents de .vibe/agents/). Copiez ce dont vous avez besoin dans votre propre
# ~/.vibe/config.toml et fournissez les tokens via des variables d'environnement —
# ne commitez jamais de vrais tokens.

active_model = "mistral-medium-3.5"

# Les connecteurs activent les namespaces d'outils MCP référencés par les agents
# (par ex. linear_* dans dev.toml, notion_* dans po.toml).
connectors = [
    { name = "linear", disabled = false },
    { name = "notion", disabled = false },
]

[[mcp_servers]]
name = "linear"
transport = "http"
url = "https://mcp.linear.app/mcp"
api_key_env = "LINEAR_MCP_TOKEN"
api_key_header = "Authorization"
api_key_format = "Bearer {token}"

[[mcp_servers]]
name = "notion"
transport = "http"
url = "https://mcp.notion.com/mcp"
api_key_env = "NOTION_MCP_TOKEN"
api_key_header = "Authorization"
api_key_format = "Bearer {token}"

# Note on-prem : pointez ces serveurs vers une gateway MCP interne plutôt que vers
# les endpoints SaaS publics — par ex. la gateway MCP interne de la CDC exposant
# Jira/Confluence ou d'autres systèmes internes. Les fichiers d'agents ne changent
# pas ; seuls les URLs des serveurs et les variables d'environnement des tokens
# changent.
