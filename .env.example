# Backend
APP_NAME=solutions-vibe-starter

# Cible de la sonde base de données pour le health-check
DB_HOST=localhost
DB_PORT=5432

# Limitation de débit (rate limiting) — valeurs par défaut si non défini :
# au plus RATE_LIMIT_REQUESTS requêtes par fenêtre de RATE_LIMIT_WINDOW_SECONDS,
# par adresse IP cliente. Les health-checks en sont exclus.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend (injecté au build) — où le navigateur atteint le backend
NEXT_PUBLIC_API_URL=http://localhost:8000
